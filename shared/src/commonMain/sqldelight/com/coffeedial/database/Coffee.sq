CREATE TABLE bean (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    roaster TEXT NOT NULL
);

CREATE TABLE machine (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    type TEXT NOT NULL,
    year TEXT NOT NULL
);

CREATE TABLE shot (
    id TEXT NOT NULL PRIMARY KEY,
    bean_id TEXT NOT NULL REFERENCES bean(id),
    created_at INTEGER NOT NULL,
    dose REAL NOT NULL CHECK(dose > 0),
    output REAL NOT NULL CHECK(output > 0),
    seconds REAL NOT NULL CHECK(seconds > 0),
    grind TEXT NOT NULL,
    temperature REAL,
    notes TEXT NOT NULL,
    rating INTEGER NOT NULL CHECK(rating BETWEEN 1 AND 5),
    milk REAL,
    machine TEXT,
    extra_water REAL,
    style TEXT
);

CREATE INDEX shot_created_at ON shot(created_at DESC);
CREATE INDEX shot_bean_id ON shot(bean_id);

insertBean:
INSERT OR IGNORE INTO bean(id, name, roaster) VALUES (?, ?, ?);

findBean:
SELECT * FROM bean WHERE name = ? AND roaster = ? ORDER BY id LIMIT 1;

insertShot:
INSERT OR REPLACE INTO shot VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

history:
SELECT shot.*, bean.name, bean.roaster
FROM shot JOIN bean ON bean.id = shot.bean_id
ORDER BY created_at DESC, shot.id DESC;

allBeans:
SELECT * FROM bean ORDER BY id;

allShots:
SELECT * FROM shot ORDER BY id;

deleteShot:
DELETE FROM shot WHERE id = ?;

updateShot:
UPDATE shot SET bean_id = ?, dose = ?, output = ?, seconds = ?, grind = ?, temperature = ?, notes = ?, rating = ?, milk = ?, machine = ?, extra_water = ?, style = ? WHERE id = ?;

allMachines:
SELECT * FROM machine ORDER BY name;

insertMachine:
INSERT OR REPLACE INTO machine VALUES (?, ?, ?, ?);

deleteMachine:
DELETE FROM machine WHERE id = ?;

CREATE TABLE sync_checkpoint (id INTEGER NOT NULL PRIMARY KEY CHECK(id = 1), value TEXT NOT NULL);

readSyncCheckpoint:
SELECT value FROM sync_checkpoint WHERE id = 1;

writeSyncCheckpoint:
INSERT OR REPLACE INTO sync_checkpoint(id, value) VALUES (1, ?);

clearShots:
DELETE FROM shot;

clearBeans:
DELETE FROM bean;

clearMachines:
DELETE FROM machine;
