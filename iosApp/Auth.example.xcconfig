COFFEE_APPLE_SIGN_IN_ENABLED = NO
COFFEE_APPLE_ENTITLEMENTS =
// Once provisioned: COFFEE_APPLE_SIGN_IN_ENABLED = YES
// Once provisioned: COFFEE_APPLE_ENTITLEMENTS = CoffeeDial.entitlements
// DEVELOPMENT_TEAM = your Apple Team ID
